{
  "name": "pi-context-vault",
  "version": "0.3.1",
  "description": "Recoverable observation storage and context-pressure reduction for Pi",
  "type": "module",
  "license": "MIT",
  "author": "Fubuyunhua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fubuyunhua/pi-context-vault.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "observation-storage",
    "context-reduction"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions/index.ts",
    "src/artifacts/redaction.ts",
    "src/artifacts/store.ts",
    "src/context/reduction.ts",
    "src/observations/virtualization.ts",
    "src/state/atomic.ts",
    "src/state/config.ts",
    "src/state/project-state.ts",
    "src/extension.ts",
    "src/telemetry.ts",
    "src/telemetry-frame.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:release": "vitest run --coverage --maxWorkers=1",
    "test:package": "node scripts/package-smoke.mjs",
    "test:pi": "node scripts/pi-rpc-smoke.mjs",
    "ci": "npm run check && npm run test:coverage && npm run test:package",
    "prepublishOnly": "npm run check && npm run test:coverage:release"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  }
}
