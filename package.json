{
  "name": "pi-context-vault",
  "version": "0.1.0",
  "description": "Recoverable observation storage and a revision-aware repository map for Pi",
  "type": "module",
  "license": "MIT",
  "author": "Fubuyunhua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fubuyunhua/pi-context-vault.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-management",
    "repo-map"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/package-smoke.mjs",
    "ci": "npm run check && npm test && npm run test:package"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "minisearch": "7.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "typebox": "1.3.7",
    "vitest": "4.1.10"
  }
}
